# Hepsi opsiyonel — hiçbiri ayarlanmadan uygulama çalışır.

# Which callsign prefix to track (default: PGT, Pegasus Airlines' ICAO code).
VITE_CALLSIGN_PREFIX=PGT

# How often the UI refreshes, in milliseconds (default: 30000).
# This does not drive the upstream call rate on its own — /api/states is cached
# at the edge (CACHE_SECONDS in api/states.js), so polls inside one cache
# window are served without touching OpenSky.
VITE_POLL_INTERVAL_MS=30000

# Bounding box for the OpenSky query. Bounding it cuts the response from
# megabytes to about 35 KB. OpenSky prices a query by the area it covers, so a
# smaller box is also cheaper in credits.
# The default covers Europe, North Africa, the Middle East and Central Asia.
VITE_BBOX_LAMIN=15
VITE_BBOX_LAMAX=65
VITE_BBOX_LOMIN=-15
VITE_BBOX_LOMAX=80

# Server-side only (no VITE_ prefix, so these never reach the browser).
# Set both in the Vercel project to let /api/states use OpenSky's OAuth2
# client-credentials flow, which carries a much larger quota.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
