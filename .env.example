# Hepsi opsiyonel — hiçbiri ayarlanmadan uygulama çalışır.

# Which callsign prefix to track (default: PGT, Pegasus Airlines' ICAO code).
VITE_CALLSIGN_PREFIX=PGT

# How often to poll OpenSky, in milliseconds (default: 25000).
# OpenSky's anonymous access has a limited daily credit budget — don't go
# much below 20000 unless you've set up authenticated access (see README).
VITE_POLL_INTERVAL_MS=25000

# Bounding box for the OpenSky query. Keeping the query bounded costs 1 credit
# per call instead of 4, and cuts the response from megabytes to kilobytes.
# The default covers Europe, North Africa, the Middle East and Central Asia.
VITE_BBOX_LAMIN=15
VITE_BBOX_LAMAX=65
VITE_BBOX_LOMIN=-15
VITE_BBOX_LOMAX=80

# Server-side only (no VITE_ prefix, so these never reach the browser).
# Set both in the Vercel project to let /api/states use OpenSky's OAuth2
# client-credentials flow, which carries a much larger quota.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
