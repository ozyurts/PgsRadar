# Hepsi opsiyonel — hiçbiri ayarlanmadan uygulama çalışır.

# Which callsign prefix to track (default: PGT, Pegasus Airlines' ICAO code).
VITE_CALLSIGN_PREFIX=PGT

# How often the UI refreshes, in milliseconds (default: 30000).
# This does not drive the upstream call rate on its own — /api/states is cached
# at the edge (CACHE_SECONDS in api/states.js), so polls inside one cache
# window are served without touching the ADS-B aggregators.
VITE_POLL_INTERVAL_MS=30000
